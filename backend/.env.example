PORT=4000
NODE_ENV=development
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dayflow
JWT_SECRET=change-me-super-secret-jwt-key-32chars
JWT_REFRESH_SECRET=change-me-refresh-secret-32chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
STORAGE_PATH=./storage
EMAIL_FROM=noreply@dayflow.local

# LinkedIn integration (optional) — create an app at https://www.linkedin.com/developers/apps
# Products: "Sign In with LinkedIn using OpenID Connect" + "Share on LinkedIn"
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:4000/api/linkedin/callback
# optional: 32-byte key (hex or base64) for encrypting stored tokens; defaults to a key derived from JWT_SECRET
LINKEDIN_TOKEN_KEY=
# optional: Posts API version (YYYYMM)
LINKEDIN_API_VERSION=202601
# where OAuth redirects land after the callback (defaults to first CORS_ORIGIN)
FRONTEND_URL=http://localhost:5173
