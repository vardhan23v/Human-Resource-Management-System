PORT=4000
NODE_ENV=development
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dayflow
JWT_SECRET=change-me-super-secret-jwt-key-32chars
JWT_REFRESH_SECRET=change-me-refresh-secret-32chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
STORAGE_PATH=./storage
EMAIL_FROM=noreply@dayflow.local

# LinkedIn integration (optional) — create an app at https://www.linkedin.com/developers/apps
# Products: "Sign In with LinkedIn using OpenID Connect" + "Share on LinkedIn"
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:4000/api/linkedin/callback
# optional: 32-byte key (hex or base64) for encrypting stored tokens; defaults to a key derived from JWT_SECRET
LINKEDIN_TOKEN_KEY=
# optional: Posts API version (YYYYMM)
LINKEDIN_API_VERSION=202601
# where OAuth redirects land after the callback (defaults to first CORS_ORIGIN)
FRONTEND_URL=http://localhost:5173

# ── Storage: local (default) or s3 (AWS S3 / Cloudflare R2 / MinIO)
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=            # e.g. https://<accountid>.r2.cloudflarestorage.com (leave empty for AWS)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# ── Email: Resend API key OR SMTP URL. Neither → emails are logged, not sent.
RESEND_API_KEY=
SMTP_URL=               # smtp://user:pass@smtp.example.com:587
# ── Distributed rate limiting (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# ── Error monitoring
SENTRY_DSN=
